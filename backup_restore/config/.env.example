# Docker Volume Backup & Restore System Environment Variables

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_BASE_PATH=/var/backups/flowdocs

# S3 Configuration (if using S3 backend)
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_ENDPOINT_URL=https://s3.wasabisys.com
S3_BUCKET=flowdocs-backups
S3_REGION=us-east-1

# Metadata Configuration
METADATA_DB_PATH=/var/backups/flowdocs/metadata.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=/var/log/backup-restore.log
